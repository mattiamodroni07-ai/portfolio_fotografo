# Header per Cloudflare (Pages/Workers static assets)
# https://developers.cloudflare.com/workers/static-assets/headers/

/*
  # ⚠️ TEMPORANEO — tiene il sito FUORI dai risultati di ricerca finché è in lavorazione.
  # RIMUOVERE questa riga (e il meta "robots" in index.html) quando il sito è pronto.
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  # I file hanno nomi fissi (non hashati): il browser deve SEMPRE ricontrollare
  # col server se sono cambiati (risposta 304 se identici, quindi resta veloce).
  # Cosi' ogni aggiornamento si vede subito, senza cache "immutable" appiccicosa.
  Cache-Control: public, no-cache
